# Tesla Road Trip Game Server Environment Variables
# Copy this file to .env and fill in your values

# Ngrok Configuration
# Get your auth token from https://dashboard.ngrok.com/get-started/your-authtoken
# Supports both NGROK_AUTHTOKEN and NGROK_AUTH_TOKEN
NGROK_AUTH_TOKEN=your-ngrok-auth-token-here

# Enable ngrok tunnel (set to true or 1 to enable)
NGROK_ENABLED=false

# Optional: Custom ngrok domain (requires paid ngrok account)
# NGROK_DOMAIN=your-custom-domain.ngrok-free.app

# Server Configuration (optional, can also use command line flags)
# PORT=8080
# HOST=localhost
# DEBUG=false

# Game Configuration (optional)
# CONFIG_DIR=configs
# DEFAULT_CONFIG=classic

# Security — public deployment hardening
# All default to enabled (true) for backward-compatible localhost dev.
# Set to false when exposing publicly via ngrok or production.

# Disable GraphQL introspection (hides schema from public)
# GRAPHQL_INTROSPECTION=false

# Disable GraphQL playground UI
# GRAPHQL_PLAYGROUND=false

# Disable MCP endpoint
# MCP_ENABLED=false

# Require X-Admin-Key header for map create/update/delete mutations.
# ADMIN_API_KEY must be set for admin mutations. For local-only development,
# opt out explicitly with ALLOW_UNAUTHENTICATED_ADMIN=true.
# ADMIN_API_KEY=change-me-to-a-secret-value
# ALLOW_UNAUTHENTICATED_ADMIN=false

# WebSocket origin allowlist — comma-separated exact origins.
# Empty (default) allows all origins. Set for public deployments.
# ALLOWED_ORIGINS=https://myapp.example.com,http://localhost:5173