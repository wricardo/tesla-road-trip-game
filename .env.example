# Tesla Road Trip Game Server Environment Variables
# Copy this file to .env and fill in your values

# Server port/host are set with flags: -port 8000 -host localhost

# Directories (optional)
# CONFIG_DIR=maps
# SESSIONS_DIR=sessions
# Where user-created maps are stored (must be writable and survive redeploys).
# Defaults to $CONFIG_DIR/custom.
# CUSTOM_MAPS_DIR=maps/custom

# Security — public deployment hardening
# All default to enabled (true) for backward-compatible localhost dev.
# Set to false when exposing publicly or in production.

# Disable GraphQL introspection (hides schema from public)
# GRAPHQL_INTROSPECTION=false

# Disable GraphQL playground UI
# GRAPHQL_PLAYGROUND=false

# Disable MCP endpoint
# MCP_ENABLED=false

# Map administration
# Creating a map needs no credentials: createMap/create_map return a one-time
# edit key that update/delete require. Built-in maps (shipped in maps/) can only
# be modified by an admin. Set ADMIN_API_KEY to send X-Admin-Key, which overrides
# both rules; ALLOW_UNAUTHENTICATED_ADMIN=true is a local-only bypass.
# ADMIN_API_KEY=change-me-to-a-secret-value
# ALLOW_UNAUTHENTICATED_ADMIN=false

# WebSocket origin allowlist — comma-separated exact origins.
# Empty (default) allows all origins. Set for public deployments.
# ALLOWED_ORIGINS=https://myapp.example.com,http://localhost:5173
